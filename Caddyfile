# The Caddyfile is an easy way to configure your Caddy web server.
#
# This box sits behind a Cloudflare Tunnel (see nix/nixos/webserver.nix).
# Cloudflare terminates public TLS at its edge and cloudflared hands plain
# HTTP to Caddy on localhost:80, so Caddy must NOT try to provision its own
# certificates or redirect HTTP -> HTTPS. Hence auto_https off below.
#
# Site addresses stay as bare hostnames so Caddy still vhost-routes on Host.
{
	auto_https off
}


### Raw HTML/CSS/JS ###
design.jsonbateman.com {
	root * /var/www/html/design-system

	file_server
}

alug.us {
	root * /var/www/html/alug.us

	file_server
}

tsukinominori.com {
	root * /var/www/html/tsukinominori.com

	file_server
}

pokermon.club {
	root * /var/www/html/poker_stats/portal/dist

	file_server
}

### Running Services ###
jsonbateman.com {
	reverse_proxy localhost:3000
}

api.pokermon.club {
	reverse_proxy localhost:7777
}

crabspy.com {
	reverse_proxy localhost:3012
}

basicauth.jsonbateman.com {
	reverse_proxy localhost:3033
}
