# --- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="af-magic"
plugins=(git autojump)
source "$ZSH/oh-my-zsh.sh"

# --- locale/editor/term/path ---
export LANG=en_US.UTF-8
export EDITOR=nvim
if [[ -n "$TMUX" ]]; then export TERM=tmux-256color; else export TERM=xterm-256color; fi
export PATH="$HOME/dotfiles/scripts:$PATH"
export PATH="/usr/local/bin:$PATH"

# --- keybindings ---
bindkey -v
export KEYTIMEOUT=1

# --- history ---
HISTFILE=$HOME/.zhistory
HISTSIZE=10000
SAVEHIST=10000
HIST_STAMPS="yyyy/mm/dd"
setopt share_history hist_expire_dups_first hist_ignore_dups hist_verify

# --- aliases ---
alias tks='tmux kill-session'
alias tms='tmux-sessionizer'
alias f='cd $(fd --type directory | fzf)'
alias lg='lazygit'

# --- mise ---
eval "$("$HOME/.local/bin/mise" activate zsh)"

# --- extras (guarded sourcing) ---
try-source() { for p in "$@"; do [[ -r "$p" ]] && source "$p" && return 0; done; }

# autosuggestions
try-source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
           "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"

# syntax highlighting (must load AFTER autosuggestions)
try-source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
           "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# autojump
try-source /etc/profile.d/autojump.zsh \
           /usr/share/autojump/autojump.zsh \
           "$HOME/.autojump/etc/profile.d/autojump.sh"

