# plugins
plugins=(autojump virtualenv zsh-autosuggestions zsh-syntax-highlighting)
export ZSH="/Users/jack/.oh-my-zsh"
ZSH_THEME="af-magic"
source $ZSH/oh-my-zsh.sh

#---------
# Aliases
#---------

alias tkS='tmux kill-server'
alias tks='tmux kill-session'
alias tms='tmux-sessionizer'
alias emacs='emacs -nw' # Opens emacs in current terminal instead of standalone program
alias f='cd $(fd --type directory | fzf)' # Jump into directory selected using fzf
alias yd='vercel env pull && yarn dev'
alias lg='lazygit'

example_widget() {
  echo "ligma"
  zle reset-prompt
}

zle -N example_widget
bindkey -M vicmd '^P' example_widget
bindkey -M viins '^P' example_widget

#------------------------------------
# Path and Environment Variables
#------------------------------------


export EDITOR=nvim
export TERM=tmux-256color
# Note, other variables are in the .zshenv file, the .zshenv file contains variables available to other programs
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/Users/jack/scripts/:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="/opt/homebrew/opt/sqlite/bin:$PATH"

# Add LLVM to environment
# export CXX="$(brew --prefix llvm)/bin/clang++"
# export CPPFLAGS="-I$(brew --prefix llvm)/include"
# export LDFLAGS="-L$(brew --prefix llvm)/lib"
# export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
# export PATH="/opt/homebrew/Cellar/llvm/19.1.4/bin:$PATH"

#------------------------------------
# Miscellaneous 
#------------------------------------
export HISTSIZE=100000000
export SAVEHIST=$HISTSIZE
setopt EXTENDED_HISTORY

eval "$(direnv hook zsh)"

# ---------
# Setup fzf
# ---------
if [[ ! "$PATH" == */opt/homebrew/opt/fzf/bin* ]]; then
  PATH="${PATH:+${PATH}:}/opt/homebrew/opt/fzf/bin"
fi

export PATH="/opt/homebrew/opt/lua@5.3/bin:$PATH"

# [ -s ~/.luaver/luaver ] && . ~/.luaver/luaver 
# [ -s ~/.luaver/completions/luaver.bash ] && . ~/.luaver/completions/luaver.bash

# --------------------------
# Options
# --------------------------
setopt GLOB_DOTS

# --------------------------
# Sourcing Files on Startup
# --------------------------
source "/Users/jack/.deno/env"
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
source "/opt/homebrew/opt/fzf/shell/key-bindings.zsh"


export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"
eval "$(/usr/local/bin/mise activate zsh)"

# ---------------
# Vim mode config
# ---------------
bindkey -v

# pnpm
export PNPM_HOME="/Users/jack/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
